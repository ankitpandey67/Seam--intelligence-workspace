SEAM_LLM_PROVIDER=ollama  # ollama, anthropic, or openai-compatible
SEAM_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=        # required when SEAM_LLM_PROVIDER=anthropic
OPENAI_API_KEY=           # required for OpenAI-compatible hosted APIs
SEAM_LLM_BASE_URL=        # optional provider URL; defaults to local Ollama or OpenAI API
S3_BUCKET=                # optional: also store uploads in S3 (uses your AWS credentials)
SEAM_VECTOR=              # set to "chroma" to use ChromaDB instead of TF-IDF retrieval
